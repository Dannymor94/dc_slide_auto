# ── Secrets — NEVER commit (Telegram/Airtable/Groq keys, operator password) ──
.env
.env.*
!.env.example
*.session
*.session-journal
sessions/
runtime/sessions/

# ── Python ──
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/

# ── Node ──
node_modules/

# ── OS / editor junk ──
.DS_Store
Thumbs.db
.idea/
*.swp

# ── Repo-local junk / not part of the deliverable ──
_archive_dc-deck/
/{deck/
*.pdf
scratchpad/

# ── Local preview harness (mock-data deck; dev only, never deployed) ──
deck/preview*.html
deck/manifest.json

# ── Song images: heavy PNG sources (from the PDF) stay local; only the light
#    webp deliverables are tracked (deck ships them; deploy carries them). ──
deck/assets/songs/*.png

# ── Build runtime state (Mac-side): song numbers already alerted (idempotency) ──
build/alerted_songs.json

# ── Build runtime state (Mac-side): recently used wisdom lines (dedup history) ──
build/wisdom_history.json

# ── Build run status (regenerated every build, delivered to the VPS) ──
data/last_build_status.json

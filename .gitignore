# ── Internal working docs — kept local, NOT published to GitHub ──
CLAUDE.md
DEPLOY.md
PLAN.md

# ── Secrets — NEVER commit (Telegram/Airtable/Groq keys, operator password) ──
.env
.env.*
!.env.example
*.session
*.session-journal
sessions/
runtime/sessions/

# ── Python ──
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/

# ── Node ──
node_modules/

# ── OS / editor junk ──
.DS_Store
Thumbs.db
.idea/
*.swp

# ── Repo-local junk / not part of the deliverable ──
_archive_dc-deck/
/{deck/
*.pdf
scratchpad/

# ── Local preview harness (mock-data deck; dev only, never deployed) ──
deck/preview*.html
deck/manifest.json

# ── Song images: heavy PNG sources (from the PDF) stay local; only the light
#    webp deliverables are tracked (deck ships them; deploy carries them). ──
deck/assets/songs/*.png

# ── Self-hosted OCR runtime (Tesseract.js): vendor only what the browser fetches
#    (loaders + *.wasm.js cores + gzip traineddata). These are regenerable by
#    build/setup_ocr.sh and are NOT fetched at runtime — keep them out of git:
#      *.wasm            → base64-embedded inside the sibling *.wasm.js, never fetched
#      langs/*.traineddata → CLI-only; the browser fetches the .gz (gzip default) ──
deck/assets/ocr/*.wasm
deck/assets/ocr/langs/*.traineddata
# asm.js fallbacks + npm entry point generated by setup_ocr.sh; browser runtime never fetches them
deck/assets/ocr/index.js
deck/assets/ocr/tesseract-core.js
deck/assets/ocr/tesseract-core-simd.js
deck/assets/ocr/tesseract-core-lstm.js
deck/assets/ocr/tesseract-core-simd-lstm.js

# ── Build runtime state (Mac-side): song numbers already alerted (idempotency) ──
build/alerted_songs.json

# ── Build runtime state (Mac-side): recently used wisdom lines (dedup history) ──
build/wisdom_history.json

# ── Build run status (regenerated every build, delivered to the VPS) ──
data/last_build_status.json

# dc-deck environment — copy to .env and fill in. NEVER commit the real .env.
# Split by where each value is used (see CLAUDE.md: Mac-build vs VPS).

# ── VPS: server (FastAPI + Postgres) ─────────────────────────────────────────
# Postgres 16: needs GRANT ON DATABASE + GRANT ON SCHEMA public + ALTER OWNER.
DATABASE_URL=postgresql://dcdeck:CHANGE_ME@localhost:5432/dcdeck
# Operator form basic-auth (POST /api/selection, /api/operator)
OPERATOR_USER=operator
OPERATOR_PASS=change-me

# ── Mac build: Telegram (Telethon, reused Crosspost session — read-only) ──────
# dc-deck names take precedence; TG_* are Crosspost fallbacks (see fetch_telegram.py).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=runtime/sessions/telegram.session
# Crosspost .env loaded as a fallback layer for the above (api_id/hash/session)
CROSSPOST_ENV=/Users/you/Documents/crosspost/runtime/.env
# Rostov Unit chat — program + finance posts
TELEGRAM_CHAT=-100XXXXXXXXXX
TELEGRAM_SENDER=-100XXXXXXXXXX
TELEGRAM_HISTORY_DAYS=7
TELEGRAM_FINANCE_DAYS=30
# СВАДХЬЯЯ chat — newest Dada YouTube link
TELEGRAM_SVADHYAYA_CHAT=-100XXXXXXXXXX
TELEGRAM_SVADHYAYA_DAYS=6

# ── Mac build: Airtable (news) ───────────────────────────────────────────────
AIRTABLE_TOKEN=

# ── Mac build: LLM — single point (extract_program). Groq primary, OpenRouter fallback ──
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# ── Mac build: fundraising plan constant ─────────────────────────────────────
DC_PLAN=30000

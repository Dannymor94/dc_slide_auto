# Template for /opt/projects/dc-deck/.env  (chmod 600, never via rsync, never in git).
# Variable names must match exactly what the code reads (grep os.environ server/):
#   DATABASE_URL, OPERATOR_USER, OPERATOR_PASS.
# No inline comments on value lines — systemd takes the whole line as the value.
# DB password: letters+digits only — @ : / ' and spaces break the connection string.

# Paste the connection string printed by /opt/scripts/new-db.sh dc-deck:
DATABASE_URL=postgresql://dc_deck_user:REPLACEME@127.0.0.1:5432/dc_deck
OPERATOR_USER=operator
OPERATOR_PASS=REPLACEME

# REFERENCE ONLY — do NOT overwrite /etc/caddy/Caddyfile with this.
#
# Per PLATFORM-CONTRACT §6 the main Caddyfile is a thin `import /etc/caddy/sites/*.caddy`.
# This project's block is generated on the server by:
#
#   bash /opt/scripts/register-site.sh dc-deck 8014 dc.vnedrum.ru /opt/projects/dc-deck/dist
#
# which drops the block at /etc/caddy/sites/dc-deck.caddy and reloads Caddy — the main
# Caddyfile and other sites (vnedrum, ycab, zo) are never touched.
#
# The generated block matches the shape below. No basic_auth here: auth lives in FastAPI
# (GET /api/operator, POST /api/selection). No custom /manifest.json or /operator handle:
# manifest.json + theme.json ship inside dist/, and /operator moved to /api/operator so
# the standard /api/* proxy covers it.

dc.vnedrum.ru {
    encode gzip

    # CSP — all resources are self-hosted (Manrope woff2 + reveal.js).
    # The only remaining external origin is YouTube (Player API script + iframes).
    # style-src 'unsafe-inline': slides inject <style> blocks and style= attributes
    # via innerHTML; this deck has no user input, so XSS surface is minimal.
    #
    # CSP — all resources are self-hosted (Manrope woff2 + reveal.js).
    # The only remaining external origin is YouTube (Player API script + iframes).
    # style-src 'unsafe-inline': slides inject <style> blocks and style= attributes
    # via innerHTML; this deck has no user input, so XSS surface is minimal.
    # Currently in Report-Only; switch header name to Content-Security-Policy after clean prогон.
    header Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' https://www.youtube.com; style-src 'self' 'unsafe-inline'; frame-src https://www.youtube.com https://www.youtube-nocookie.com; img-src 'self' data: https://i.ytimg.com; font-src 'self'; connect-src 'self'; media-src 'self';"

    # manifest.json changes weekly — must revalidate every request.
    # no-cache = always revalidate with etag; no-store would defeat etag.
    header /manifest.json Cache-Control "no-cache, must-revalidate"

    # Fonts and vendored reveal.js are content-addressed (never change in place).
    header /assets/fonts/* Cache-Control "public, max-age=31536000, immutable"
    header /assets/vendor/* Cache-Control "public, max-age=31536000, immutable"

    handle /api/* {
        reverse_proxy 127.0.0.1:8014
    }

    handle {
        root * /opt/projects/dc-deck/dist
        try_files {path} {path}/index.html {path}.html /index.html
        file_server
    }
}

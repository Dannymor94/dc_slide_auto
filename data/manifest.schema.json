{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "date",
    "program",
    "news"
  ],
  "additionalProperties": false,
  "properties": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "program": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "time",
          "title"
        ],
        "additionalProperties": false,
        "properties": {
          "time": {
            "type": "string",
            "pattern": "^\\d{2}:\\d{2}$"
          },
          "title": {
            "type": "string"
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "news": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dada_comment": {
      "type": [
        "string",
        "null"
      ]
    },
    "final_music_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "suggested_songs": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    }
  }
}
